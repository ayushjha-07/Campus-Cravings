# ==============================================================================
# Campus Cravings — Environment Configuration Template
# CGC University, Mohali
# ==============================================================================
# Copy this file to .env to configure live API services for OTP verification.
# Never commit your actual .env file or API credentials to version control.

# Server Port (optional, default 3001)
PORT=3001

# ==============================================================================
# 1. EMAIL SERVICE CONFIGURATION (Resend)
# ==============================================================================
# Sign up at https://resend.com to generate your API key.
# For testing, Resend provides free sending to your registered account email.
# For production, verify your CGC domain (e.g., mail.cgc.edu.in).
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=Campus Cravings <onboarding@resend.dev>

# ==============================================================================
# 2. SMS SERVICE CONFIGURATION (Indian Mobile Numbers)
# ==============================================================================
# Option A: Fast2SMS (Indian SMS Gateway optimized for DLT / Quick OTP route)
# Sign up at https://www.fast2sms.com to obtain your API key.
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Option B: Twilio (Global SMS Gateway)
# Sign up at https://www.twilio.com to get your Account SID, Auth Token & Number.
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# ==============================================================================
# 3. OTP & SECURITY POLICIES (Defaults)
# ==============================================================================
# OTP_EXPIRY_MS=300000          # 5 minutes in milliseconds
# OTP_RESEND_COOLDOWN_MS=60000  # 60 seconds resend cooldown
# OTP_MAX_ATTEMPTS=5            # Maximum failed attempts before lockout
